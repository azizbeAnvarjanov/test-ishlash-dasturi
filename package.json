{
  "name": "test-ishlash-dasturi",
  "version": "1.0.2",
  "private": true,
  "description": "Lokal tarmoq orqali test o'tkazish uchun Server va Student Electron dasturlari",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@test/server",
    "dev:student": "npm run dev --workspace=@test/student",
    "build": "npm run build --workspace=@test/shared && npm run build --workspace=@test/server && npm run build --workspace=@test/student",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dist:server": "npm run dist --workspace=@test/server",
    "dist:student": "npm run dist --workspace=@test/student",
    "release:server": "npm run release --workspace=@test/server",
    "release:student": "npm run release --workspace=@test/student"
  },
  "engines": {
    "node": ">=22"
  }
}
